{
  "name": "roon-discord-publish",
  "version": "0.7.0",
  "description": "Roon Extension for Discord Rich Presence - GUI Edition",
  "main": "src/main/main.js",
  "homepage": "https://github.com/your-repo/roon-discord-publish",
  "scripts": {
    "start": "node start.js",
    "local": "node run-with-local-node.js",
    "setup-local-node": "node setup-local-node.js",
    "direct": "node roon-discord-publish.js",
    "dev": "node roon-discord-publish.js",
    "check-node": "node --version",
    "setup": "npm install && echo 'Please copy config.example.json to config.json and configure your settings'",
    "electron": "electron .",
    "electron-dev": "cross-env NODE_ENV=development electron .",
    "electron-debug": "cross-env NODE_ENV=development electron . --inspect=5858",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "dist": "npm run build",
    "clean": "rimraf dist",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-builder install-app-deps"
  },
  "engines": {
    "node": ">=16.13.2 <17.0.0",
    "npm": ">=8.0.0"
  },
  "author": "615283 (James Conway), synapses, jaredallard",
  "license": "Apache-2.0",
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "fs": "^0.0.1-security",
    "fsa": "^0.5.1",
    "imgur-anonymous-uploader": "^1.1.6",
    "imgur-node-api": "^0.1.0",
    "node-roon-api": "github:roonlabs/node-roon-api",
    "node-roon-api-image": "github:RoonLabs/node-roon-api-image",
    "node-roon-api-transport": "github:roonlabs/node-roon-api-transport",
    "spotify-web-api-node": "^5.0.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "rimraf": "^5.0.10"
  },
  "build": {
    "appId": "com.echofox.roon-discord-publish",
    "productName": "Roon Discord Rich Presence",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "config.example.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
